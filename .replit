modules = ["nodejs-20", "postgresql-16"]

[nix]
channel = "stable-24_05"
packages = ["wget", "curl", "imagemagick"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Saddlewood Website Server"

[[workflows.workflow]]
name = "Saddlewood Website Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd workspace/saddlewood-website && npm run build && npm run start"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[deployment]
run = ["sh", "-c", "cd workspace/saddlewood-website && npm run start"]
build = ["sh", "-c", "cd workspace/saddlewood-website && npm run build"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 38563
externalPort = 3000

[agent]
expertMode = true
