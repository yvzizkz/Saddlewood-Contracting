# SendGrid API key for email notifications
SENDGRID_API_KEY=your_sendgrid_api_key_here

# Database connection string (if applicable)
DATABASE_URL=your_production_database_url_here

# Next Auth secret for session encryption
NEXTAUTH_SECRET=your_next_auth_secret_here
NEXTAUTH_URL=https://saddlewoodcontracting.com

# Site URL for absolute URL generation
NEXT_PUBLIC_SITE_URL=https://saddlewoodcontracting.com

# Contact information
NEXT_PUBLIC_CONTACT_EMAIL=info@saddlewoodcontracting.com
NEXT_PUBLIC_CONTACT_PHONE=480-999-6100

# Google Analytics ID (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX